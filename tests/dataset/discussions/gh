#!/usr/bin/env bash
# Stands in for gh in the posting script's tests: records each call's arguments, one per
# line and a blank line after the call, in GH_CALLS, answers the categories query with
# GH_CATEGORIES, and answers a create with a discussion's address unless its title is
# GH_REFUSED_TITLE.
set -euo pipefail
printf '%s\n' "$@" "" >>"${GH_CALLS}"
for argument in "$@"; do
  case "${argument}" in
    query=@*categories*) cat "${GH_CATEGORIES}"; exit 0 ;;
    title="${GH_REFUSED_TITLE:-}") echo "GraphQL: refused" >&2; exit 1 ;;
  esac
done
echo "https://github.com/discussions/1"
